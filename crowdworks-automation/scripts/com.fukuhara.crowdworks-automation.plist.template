<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd用 LaunchAgent 雛形(テンプレート)。

  【重要】このファイルはまだ ~/Library/LaunchAgents/ には配置していません。
  本登録するときは、以下の手順で行ってください(実装担当が指示するまで実行しないこと)。

    1. このファイルを ~/Library/LaunchAgents/com.fukuhara.crowdworks-automation.plist
       としてコピーする
    2. launchctl load ~/Library/LaunchAgents/com.fukuhara.crowdworks-automation.plist
       で読み込む
    3. 解除する場合は
       launchctl unload ~/Library/LaunchAgents/com.fukuhara.crowdworks-automation.plist

  朝6:00・昼12:00・夜19:00の3回、scripts/run-scheduled.sh を起動する。
  実際にどの回に該当するか(朝/昼/夜)・スリープ等による遅延判定は
  run-scheduled.sh 側で判定するため、このplist自体は単純に3つの時刻を
  登録するだけでよい。

  【時刻を変更したい場合】
  以下の2箇所を「必ずセットで」同じ時刻に変更すること(このplistの時刻を
  変えるだけでは、run-scheduled.sh側の遅延判定が古い時刻を基準に計算してしまう)。
    1. このファイルの StartCalendarInterval(下記3つのdict)
    2. scripts/run-scheduled.sh の SLOT_HOURS / SLOT_LABELS 変数
  変更後は、本登録前に本ドキュメントの手順で launchctl bootout → cp → bootstrap
  をやり直すこと(launchdは実行中のplist定義をファイル書き換えだけでは
  自動的に再読込しない)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fukuhara.crowdworks-automation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/fukuharakeisuke/Downloads/セットアップ/my-workspace/crowdworks-automation/scripts/run-scheduled.sh</string>
  </array>

  <!-- 朝6:00・昼12:00・夜19:00。変更時は scripts/run-scheduled.sh の
       SLOT_HOURS/SLOT_LABELS も必ず同じ時刻へ変更すること -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>19</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <!-- 起動時(ログイン時)には実行しない。あくまで上記3時刻のみ -->
  <key>RunAtLoad</key>
  <false/>

  <!-- launchdの標準出力/エラー出力(run-scheduled.sh自体のログとは別に、launchdが
       スクリプト起動自体に失敗した場合の記録用)。data/配下はGit管理外。 -->
  <key>StandardOutPath</key>
  <string>/Users/fukuharakeisuke/Downloads/セットアップ/my-workspace/crowdworks-automation/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/fukuharakeisuke/Downloads/セットアップ/my-workspace/crowdworks-automation/data/logs/launchd.err.log</string>
</dict>
</plist>
